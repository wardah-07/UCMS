{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    /* Vite/the client resolve straight to this .ts source natively.
   server/ (plain Node/tsx) cannot do this remapping, so shared/
   also has a separate build step (tsconfig.build.json) producing
   dist/ for Node-based consumers. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    /* No legacy JS to migrate here (unlike client/) - this package is new
       to TS, so it starts strict. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["."]
}
